# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ENCRYPTION_KEK: 64-character hex string (32 bytes) used as the Master Key Encryption Key (AES-256-GCM).
ENCRYPTION_KEK="CHANGE_ME_64_HEX_CHARS"

# BLIND_INDEX_PEPPER: Secret pepper string for HMAC-SHA256 blind indexing.
BLIND_INDEX_PEPPER="CHANGE_ME_BLIND_INDEX_PEPPER"

# ALIAS_RELAY_DOMAIN: Domain used when provisioning per-broker alias email addresses.
ALIAS_RELAY_DOMAIN="relay.privavault.local"

# EMAIL_FROM_ADDRESS: Verified sender address for outbound GDPR/CCPA notices.
EMAIL_FROM_ADDRESS="privacy@privavault.local"

# RESEND_API_KEY / SENDGRID_API_KEY: Optional real email API key for live dispatch.
RESEND_API_KEY=""
SENDGRID_API_KEY=""

# INBOUND_WEBHOOK_SECRET: Shared secret header (x-webhook-secret) for inbound broker replies.
INBOUND_WEBHOOK_SECRET="CHANGE_ME_WEBHOOK_SECRET"
